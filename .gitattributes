* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
# Unified diffs require a single space on empty context lines.
*.patch -whitespace
# Preserve third-party license text verbatim, including original whitespace.
licenses/** -text -whitespace
*.png binary
*.ico binary
